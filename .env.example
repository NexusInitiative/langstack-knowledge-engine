# Postgres connection — used by docker-compose.yml and src/lkengine/db/connection.py.
POSTGRES_USER=lkengine
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=lkengine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Convenience: a single DSN for app code (psycopg accepts this directly).
DATABASE_URL=postgresql://lkengine:change-me-locally@localhost:5432/lkengine
